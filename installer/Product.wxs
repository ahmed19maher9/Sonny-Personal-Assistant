<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sonny MSI payload definition.

  Path conventions - WiX resolves the two forms differently, so both are used
  deliberately below:
    - <File Source="...">     relative to the working directory, i.e. the project
                              root (build_installer.bat runs "wix build" from the
                              repository root, see its "cd /d %~dp0").
    - <Files Include="..."/>  relative to THIS file's directory (installer\),
                              hence the "..\" prefixes. Used to graft whole
                              asset trees (Kokoro voice/phonemizer data) into the
                              package without listing hundreds of files.

  llama.cpp (CPU + CUDA + Vulkan backends) is now statically linked into
  personal_assistant.exe, so the former llama.dll / ggml*.dll payload is gone.
  GPU support only needs the CUDA runtime DLLs (cuBLAS, cuBLASLt, cudart). The
  Vulkan loader (vulkan-1.dll) is NOT part of this payload: it belongs to the
  graphics driver, which installs it into C:\Windows\System32, and shipping an
  app-local copy would shadow that newer system loader.

  Architecture: this package must be built with "wix build -arch x64".
  personal_assistant.exe is an x64 binary, and an x86 package would place it
  under Program Files (x86) via the 32-bit ProgramFilesFolder redirection.

  WebView2Loader.dll is NOT optional: the executable statically imports it
  (MeshDialog drives the mesh viewer through the WebView2 COM API), so a
  machine without it cannot even start Sonny. The Edge WebView2 *runtime*
  itself is installed by Windows/Edge and is deliberately not shipped.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Sonny"
           Manufacturer="Sony"
           Version="1.0.0.0"
           UpgradeCode="5ad67def-2c01-4a16-8c6a-256de9d9a092"
           InstallerVersion="500">

     <!-- Icon SourceFile is resolved by the compiler against the working
          directory (the repository root), unlike the <Files Include="...">
          patterns below. -->
     <Icon Id="SonnyIcon" SourceFile="resources\images\logo.ico" />
     <Property Id="ARPPRODUCTICON" Value="SonnyIcon" />

     <!-- EmbedCab keeps the result a single self-contained .msi. The default
          LZX level is kept deliberately: lowering it only trades build time
          for a much larger package (the ~1.8 GB payload already compresses
          to ~875 MB at the default). -->
     <MediaTemplate EmbedCab="yes" />

     <MajorUpgrade DowngradeErrorMessage="A newer version of Sonny is already installed." />

     <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

     <Feature Id="ProductFeature" Title="Sonny" Level="1">
        <ComponentGroupRef Id="ProductComponents" />
        <ComponentGroupRef Id="WebView2Loader" />
        <ComponentGroupRef Id="GpuRuntimeDLLs" />
       <ComponentGroupRef Id="KokoroRuntimeDLLs" />
       <ComponentGroupRef Id="CT2DLLs" />
       <ComponentGroupRef Id="ONNXDLLs" />
       <ComponentGroupRef Id="Assets" />
       <ComponentGroupRef Id="Avatars" />
       <ComponentGroupRef Id="Videos" />
       <ComponentGroupRef Id="Sounds" />
       <ComponentGroupRef Id="ModelsDirectory" />
       <ComponentGroupRef Id="WhisperModels" />
       <ComponentGroupRef Id="WakeWordModels" />
        <ComponentGroupRef Id="KokoroConfig" />
        <ComponentGroupRef Id="KokoroOnnxModels" />
        <ComponentGroupRef Id="KokoroVoices" />
        <ComponentGroupRef Id="KokoroEspeakData" />
        <ComponentGroupRef Id="KokoroLexicon" />
        <ComponentGroupRef Id="MeshWebAssets" />
        <ComponentGroupRef Id="EmbeddingModel" />
        <ComponentGroupRef Id="Relay" />
        <ComponentRef Id="ShortcutComponent" />
        <ComponentRef Id="SonnyConfigComponent" />
      </Feature>

     <StandardDirectory Id="ProgramFilesFolder">
   <Directory Id="INSTALLFOLDER" Name="Sonny">
     <Directory Id="WEBDIR" Name="web" />
     <Directory Id="AVATARSDIR" Name="avatars" />
     <Directory Id="VIDEOSDIR" Name="videos" />
     <Directory Id="SOUNDSDIR" Name="sounds" />
     <Directory Id="MODELSDIR" Name="models">
       <Directory Id="WHISPERDIR" Name="whisper-base-ct2" />
       <Directory Id="WAKEWORDDIR" Name="openwakeword" />
       <!-- RAG dense-retrieval model. Kept under its real name: the ONNX
            export in resources\models is bge-large-en-v1.5, and the mesh
            protocol reports this name to peers (VectorsSync), so shipping it
            under a different directory name would misreport the model to
            other nodes. RagEngine's default model key is still
            "all-MiniLM-L6-v2", so a fresh install currently falls back to
            BM25-only ranking until that default is pointed here. -->
       <Directory Id="EMBEDDINGDIR" Name="bge-large-en-v1.5" />
     </Directory>
     <!-- Production layout: main.cpp resolves the TTS assets to
          <install dir>\kokoro (development uses <repo>\models\kokoro). -->
     <Directory Id="KOKORODIR" Name="kokoro">
       <Directory Id="KOKORO82MDIR" Name="Kokoro-82M" />
       <Directory Id="KOKOROONNXDIR" Name="onnx" />
       <Directory Id="KOKOROVOICESDIR" Name="voices_npy" />
       <Directory Id="KOKOROESPEAKDIR" Name="espeak-ng-data" />
       <Directory Id="KOKOROMISAKIDIR" Name="misaki-data" />
     </Directory>
   </Directory>
 </StandardDirectory>

     <StandardDirectory Id="DesktopFolder" />
     <StandardDirectory Id="ProgramMenuFolder" />
   </Package>

   <Fragment>
     <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
       <Component Id="MainExecutable" Guid="*">
         <File Id="personal_assistant.exe"
               Source="build\Release\personal_assistant.exe"
               KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <!-- personal_assistant.exe imports WebView2Loader.dll statically (see the
        note at the top of this file), so it has to sit next to the exe or the
        process fails to start. MeshDialog additionally probes it with
        LoadLibraryA() to decide whether to show the mesh window. -->
   <Fragment>
     <ComponentGroup Id="WebView2Loader" Directory="INSTALLFOLDER">
       <Component Id="WebView2LoaderComponent" Guid="9A1B2C3D-4E5F-4A6B-8C7D-9E0F1A2B3C4D">
         <File Id="WebView2Loader.dll"
               Source="build\Release\WebView2Loader.dll"
               KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <!-- The vectors rendezvous relay (tools/relay/SonnyRelay.cpp). Needed for
        "wan" mode on networks where direct peer-to-peer is impossible; the app
        never requires it, but shipping it keeps the installed product able to
        host its own relay. -->
   <Fragment>
     <ComponentGroup Id="Relay" Directory="INSTALLFOLDER">
       <Component Id="RelayComponent" Guid="7B2C3D4E-5F60-4A7B-8C9D-0E1F2A3B4C5D">
         <File Id="sonny_relay.exe"
               Source="build\Release\sonny_relay.exe"
               KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <!-- web/ assets. web_speech.html is served by the local Web Speech API
          HTTP server (AssistantOrchestrator starts it with the path
          "resources/web/web_speech.html", resolved against the current
          directory, which main.cpp sets to the executable directory), and
          mesh.html + vis-network.min.js back the WebView2 mesh viewer, which
          MeshDialog resolves as <exe dir>\web\mesh.html. All three have to
          ship in web\ or those features silently fail to start. -->
     <ComponentGroup Id="MeshWebAssets" Directory="WEBDIR">
       <Component Id="WebSpeechHtml" Guid="*">
         <File Id="web_speech_html" Source="build\Release\web\web_speech.html" KeyPath="yes" />
       </Component>
       <Component Id="MeshHtml" Guid="*">
         <File Id="mesh_html" Source="build\Release\web\mesh.html" KeyPath="yes" />
       </Component>
       <Component Id="VisNetworkJs" Guid="*">
         <File Id="vis_network_min_js" Source="build\Release\web\vis-network.min.js" KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <!-- RAG dense-retrieval model + WordPiece vocabulary. -->
     <ComponentGroup Id="EmbeddingModel" Directory="EMBEDDINGDIR">
       <Component Id="EmbeddingModelFiles" Guid="3D8E5A21-77B4-4C19-9F0E-2A6D51B8C3F0">
         <File Id="embedding_model" Source="build\Release\models\bge-large-en-v1.5\model_int8.onnx" KeyPath="yes" />
         <File Id="embedding_vocab" Source="build\Release\models\bge-large-en-v1.5\vocab.txt" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="Assets" Directory="INSTALLFOLDER">
       <!-- resources.rc compiles the application icon and the settings /
            first-run dialog templates into the executable, so nothing from
            resources\ needs to be shipped loose. This group is kept only
            because Feature references it; it intentionally installs nothing. -->
       <Component Id="NoLooseResources" Guid="6C3D4E5F-6071-4B8C-9DAE-1F2A3B4C5D6E" />
     </ComponentGroup>
   </Fragment>

   <!-- GPU runtime: the CUDA and Vulkan ggml backends are compiled into the
        executable, so only their redistributable runtime DLLs ship here.
        vulkan-1.dll is deliberately absent - the Vulkan loader is installed by
        the graphics driver into C:\Windows\System32. -->
   <Fragment>
     <ComponentGroup Id="GpuRuntimeDLLs" Directory="INSTALLFOLDER">
       <Component Id="GpuRuntimeDLLs" Guid="12345678-1234-1234-1234-123456789ABC">
         <File Id="cudart64_12.dll" Source="build\Release\cudart64_12.dll" KeyPath="yes" />
         <File Id="cublas64_12.dll" Source="build\Release\cublas64_12.dll" />
         <File Id="cublasLt64_12.dll" Source="build\Release\cublasLt64_12.dll" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <!-- Kokoro TTS runs in-process: native espeak-ng phonemizer + OpenBLAS iSTFT.
        onnxruntime.dll is shared with the STT/wake-word engines (ONNXDLLs). -->
   <Fragment>
     <ComponentGroup Id="KokoroRuntimeDLLs" Directory="INSTALLFOLDER">
       <Component Id="KokoroRuntimeDLLs" Guid="DDDD4444-EEEE-5555-6666-777777777777">
         <File Id="libespeak_ng.dll" Source="build\Release\libespeak-ng.dll" />
         <File Id="openblas.dll" Source="build\Release\openblas.dll" KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="CT2DLLs" Directory="INSTALLFOLDER">
       <Component Id="CT2DLLs" Guid="A1111111-1111-2222-3333-444444444444">
         <File Id="ctranslate2.dll" Source="build\Release\ctranslate2.dll" KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="ONNXDLLs" Directory="INSTALLFOLDER">
       <Component Id="ONNXDLLs" Guid="B1111111-1111-2222-3333-444444444444">
         <File Id="onnxruntime.dll" Source="build\Release\onnxruntime.dll" KeyPath="yes" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="Avatars" Directory="AVATARSDIR">
       <Component Id="Avatars" Guid="FEDCBA09-8765-4321-FEDC-BA0987654321">
         <File Id="sonny_avatar" Source="build\Release\avatars\sonny.glb" KeyPath="yes" />
         <File Id="ironman_avatar" Source="build\Release\avatars\iron-man.glb" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="Videos" Directory="VIDEOSDIR">
       <Component Id="Videos" Guid="AAAA1111-BBBB-CCCC-DDDD-EEEEFFFF2222">
         <File Id="logo_loading_green" Source="build\Release\videos\logo-loading-green.wmv" KeyPath="yes" />
         <File Id="logo_start_green" Source="build\Release\videos\logo-start-green.wmv" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="Sounds" Directory="SOUNDSDIR">
       <Component Id="Sounds" Guid="AAAA2222-BBBB-CCCC-DDDD-EEEEFFFF1111">
         <File Id="sonny" Source="build\Release\sounds\sonny.wav" KeyPath="yes" />
         <File Id="sonny_my_name_is_sonny" Source="build\Release\sounds\sonny_my_name_is_sonny.wav" />
         <File Id="sonny_yes" Source="build\Release\sounds\sonny_yes.wav" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
      <ComponentGroup Id="ModelsDirectory" Directory="MODELSDIR">
        <Component Id="ModelsDir" Guid="CCCC3333-DDDD-4444-5555-666666666666">
          <CreateFolder />
          <RemoveFolder Id="RemoveModelsDir" On="uninstall" Directory="MODELSDIR" />
          <File Id="silero_vad" Source="build\Release\models\silero_vad.onnx" KeyPath="yes" />
        </Component>
      </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="WhisperModels" Directory="WHISPERDIR">
       <Component Id="WhisperModels" Guid="EEEE5555-FFFF-6666-7777-888888888888">
         <File Id="whisper_config" Source="build\Release\models\whisper-base-ct2\config.json" KeyPath="yes" />
         <File Id="whisper_model" Source="build\Release\models\whisper-base-ct2\model.bin" />
         <File Id="whisper_tokenizer" Source="build\Release\models\whisper-base-ct2\tokenizer.json" />
         <File Id="whisper_vocabulary" Source="build\Release\models\whisper-base-ct2\vocabulary.txt" />
       </Component>
     </ComponentGroup>
   </Fragment>

   <Fragment>
     <ComponentGroup Id="WakeWordModels" Directory="WAKEWORDDIR">
        <Component Id="WakeWordModels" Guid="FFFF6666-7777-8888-9999-AAAAAAAAAAAA">
          <File Id="wakeword_melspectrogram" Source="build\Release\models\openwakeword\melspectrogram.onnx" KeyPath="yes" />
          <File Id="wakeword_embedding" Source="build\Release\models\openwakeword\embedding_model.onnx" />
          <File Id="wakeword_sonny" Source="build\Release\models\openwakeword\sonny.onnx" />
        </Component>
     </ComponentGroup>
   </Fragment>

    <!-- Kokoro TTS data. KokoroWrapper::initialize() probes these exact paths
         below the model directory (<install dir>\kokoro in production):
           Kokoro-82M/config.json, onnx/{kokoro_encoder,har_generator,
           kokoro_decoder}.onnx, voices_npy/, espeak-ng-data/, misaki-data/
         The CMakeLists.txt POST_BUILD steps assemble a ready-to-ship kokoro/
         tree in build\Release\kokoro, excluding the 3.2 GB PyTorch checkpoint
         and .pt voice files (ONNX-inference only) and dev-only leftovers
         (*.lib, *.obj, helper DLLs, kokoro-cli.exe).
         The voice/phonemizer trees are grafted in with <Files>, which is a
         directory-relative pattern (see the note at the top of this file) and
         keeps the nested layout of espeak-ng-data (lang\*, voices\*). -->
    <Fragment>
      <ComponentGroup Id="KokoroConfig" Directory="KOKORO82MDIR">
        <Component Id="KokoroConfig" Guid="BBBB7777-8888-9999-AAAA-BBBBBBBBBBBB">
          <File Id="kokoro_config" Source="build\Release\kokoro\Kokoro-82M\config.json" KeyPath="yes" />
        </Component>
      </ComponentGroup>
    </Fragment>

    <Fragment>
      <ComponentGroup Id="KokoroOnnxModels" Directory="KOKOROONNXDIR">
        <Component Id="KokoroOnnxModels" Guid="CCCC8888-9999-AAAA-BBBB-CCCCCCCCCCCC">
          <File Id="kokoro_encoder" Source="build\Release\kokoro\onnx\kokoro_encoder.onnx" KeyPath="yes" />
          <File Id="kokoro_decoder" Source="build\Release\kokoro\onnx\kokoro_decoder.onnx" />
          <File Id="har_generator" Source="build\Release\kokoro\onnx\har_generator.onnx" />
        </Component>
      </ComponentGroup>
    </Fragment>

    <Fragment>
      <ComponentGroup Id="KokoroVoices" Directory="KOKOROVOICESDIR">
        <Files Include="..\build\Release\kokoro\voices_npy\*" />
      </ComponentGroup>
    </Fragment>

    <Fragment>
      <ComponentGroup Id="KokoroEspeakData" Directory="KOKOROESPEAKDIR">
        <Files Include="..\build\Release\kokoro\espeak-ng-data\**" />
      </ComponentGroup>
    </Fragment>

    <Fragment>
      <ComponentGroup Id="KokoroLexicon" Directory="KOKOROMISAKIDIR">
        <Files Include="..\build\Release\kokoro\misaki-data\**" />
      </ComponentGroup>
    </Fragment>

   <Fragment>
     <DirectoryRef Id="INSTALLFOLDER">
       <Component Id="ShortcutComponent" Guid="*">
         <Shortcut Id="DesktopShortcut"
                   Name="Sonny"
                   Description="Voice-enabled AI Assistant"
                   Target="[#personal_assistant.exe]"
                   WorkingDirectory="INSTALLFOLDER"
                   Directory="DesktopFolder" />
         <Shortcut Id="StartMenuShortcut"
                   Name="Sonny"
                   Description="Voice-enabled AI Assistant"
                   Target="[#personal_assistant.exe]"
                   WorkingDirectory="INSTALLFOLDER"
                   Directory="ProgramMenuFolder" />
         <RegistryValue Root="HKCU"
                        Key="Software\Sony\Sonny"
                        Name="installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
       </Component>
      </DirectoryRef>
    </Fragment>

   <Fragment>
     <!-- ConfigManager::get_config_path() writes config.ini to
          %APPDATA%\Sonny (CSIDL_APPDATA = roaming), not %LOCALAPPDATA%. -->
     <StandardDirectory Id="AppDataFolder">
       <Directory Id="SonnyConfigDir" Name="Sonny">
         <Component Id="SonnyConfigComponent" Guid="A1111111-B222-CCCC-DDDD-EEEEFFFF1111">
           <RemoveFile Id="RemoveConfigIni" Name="config.ini" On="uninstall" />
           <RemoveFolder Id="RemoveSonnyDir" On="uninstall" Directory="SonnyConfigDir" />
         </Component>
       </Directory>
     </StandardDirectory>
   </Fragment>
 </Wix>


